# ==============================================================
#  Vetor — .gitignore do monorepo
#  Cobre: backend (NestJS), web (Angular), mobile (Ionic/Angular + Capacitor)
# ==============================================================


# ------------------------------------------------------------------
#  Node / dependências (todas as aplicações)
# ------------------------------------------------------------------
node_modules/
**/node_modules/
jspm_packages/
.npm
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# logs de gerenciadores de pacote
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
*.log


# ------------------------------------------------------------------
#  Variáveis de ambiente / segredos
#  (mantenha versionados apenas os .env.example)
# ------------------------------------------------------------------
.env
.env.*
!.env.example
!**/.env.example
*.local

# chaves e certificados
*.pem
*.key
*.p12
*.keystore
*.jks
google-services.json
GoogleService-Info.plist


# ------------------------------------------------------------------
#  Builds / saídas de compilação
# ------------------------------------------------------------------
dist/
**/dist/
build/
**/build/
out/
tmp/
temp/
*.tsbuildinfo
.tscache/


# ------------------------------------------------------------------
#  Backend — NestJS
# ------------------------------------------------------------------
vetor-backend/dist/
vetor-backend/coverage/
vetor-backend/.nestcli.json
# uploads locais / mídia gerada em desenvolvimento (ajuste ao seu caso)
vetor-backend/uploads/
vetor-backend/tmp/


# ------------------------------------------------------------------
#  Web — Angular
# ------------------------------------------------------------------
vetor-app-web/dist/
vetor-app-web/tmp/
vetor-app-web/out-tsc/
vetor-app-web/.angular/
vetor-app-web/coverage/
vetor-app-web/connect.lock
vetor-app-web/.sass-cache/
vetor-app-web/libpeerconnection.log
vetor-app-web/testem.log
vetor-app-web/typings/


# ------------------------------------------------------------------
#  Mobile — Ionic / Angular
# ------------------------------------------------------------------
vetor-app-mobile/dist/
vetor-app-mobile/www/
vetor-app-mobile/.angular/
vetor-app-mobile/out-tsc/
vetor-app-mobile/coverage/
vetor-app-mobile/.sourcemaps/
vetor-app-mobile/.ionic/
vetor-app-mobile/.tmp/


# ------------------------------------------------------------------
#  Mobile — Capacitor (assets gerados e projetos nativos sincronizados)
# ------------------------------------------------------------------
# ícones/splash gerados por @capacitor/assets a partir do source
vetor-app-mobile/resources/android/
vetor-app-mobile/resources/ios/

# --- Android nativo ---
vetor-app-mobile/android/.gradle/
vetor-app-mobile/android/build/
vetor-app-mobile/android/app/build/
vetor-app-mobile/android/captures/
vetor-app-mobile/android/.idea/
vetor-app-mobile/android/local.properties
vetor-app-mobile/android/app/release/
vetor-app-mobile/android/app/src/main/assets/public/
vetor-app-mobile/android/app/src/main/assets/capacitor.config.json
vetor-app-mobile/android/app/src/main/assets/capacitor.plugins.json
vetor-app-mobile/android/app/src/main/res/xml/config.xml
*.apk
*.aab

# --- iOS nativo (caso adicione a plataforma) ---
vetor-app-mobile/ios/App/build/
vetor-app-mobile/ios/App/Pods/
vetor-app-mobile/ios/App/output/
vetor-app-mobile/ios/App/App/public/
vetor-app-mobile/ios/App/App/capacitor.config.json
vetor-app-mobile/ios/App/App/config.xml
vetor-app-mobile/ios/DerivedData/
*.ipa
xcuserdata/


# ------------------------------------------------------------------
#  Testes / cobertura (genérico)
# ------------------------------------------------------------------
coverage/
**/coverage/
.nyc_output/
*.lcov


# ------------------------------------------------------------------
#  Caches de ferramentas
# ------------------------------------------------------------------
.cache/
.eslintcache
.stylelintcache
.parcel-cache/
.vite/


# ------------------------------------------------------------------
#  Editores / IDEs
# ------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~


# ------------------------------------------------------------------
#  Sistema operacional
# ------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini