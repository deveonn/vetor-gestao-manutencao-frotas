# Postgres com extensão PostGIS habilitada — ver docker-compose.yml para subir uma local.
DATABASE_URL="postgresql://vetor:vetor@localhost:5432/vetor?schema=public"

# Porta da API (o painel web espera http://localhost:3000 por padrão, ver vetor-app-web)
PORT=3000

# JWT — troque os segredos antes de qualquer uso além do seu ambiente local.
JWT_SECRET="troque-este-segredo-de-access-token"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="troque-este-segredo-de-refresh-token"
JWT_REFRESH_EXPIRES_IN="30d"

# Diretório local onde as fotos de vistoria (POST /midia) são salvas em dev.
# Trocar por um storage de objetos (S3-compatible) antes de produção — ver README-backend.md.
UPLOADS_DIR="./uploads"
