# Postgres com extensão PostGIS habilitada — ver docker-compose.yml para subir uma local.
DATABASE_URL="postgresql://vetor:vetor@localhost:5432/vetor?schema=public"

# Porta da API (o painel web espera http://localhost:3000 por padrão, ver vetor-app-web)
PORT=3000

# Origens permitidas por CORS, separadas por vírgula (sem espaço extra necessário).
# Em produção, trocar pelo(s) domínio(s) reais do painel web / app mobile.
# Dev: painel web (ng serve, 4200), app mobile no browser (ng serve/ionic serve, 8100) e o app mobile dentro
# do Capacitor (https://localhost no Android, capacitor://localhost no iOS).
CORS_ORIGIN="http://localhost:4200,http://localhost:8100,https://localhost,capacitor://localhost"

# Em produção: NODE_ENV=production liga as validações de ambiente mais rígidas (src/config/env.validation.ts).
# NODE_ENV="production"

# JWT — troque o segredo antes de qualquer uso além do seu ambiente local. Em produção: 32+ caracteres
# (ex.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))").
# O refresh token não é JWT (string aleatória guardada com hash no banco), então não tem segredo próprio.
JWT_SECRET="troque-este-segredo-de-access-token"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Tentativas de POST /auth/login por IP por minuto (padrão 10). Em dev os testes e2e logam muitas vezes
# seguidas — use um valor alto no .env local.
LOGIN_LIMITE_POR_MINUTO=1000

# Fotos das vistorias (POST /midia):
# - "local": disco em UPLOADS_DIR, servido pela API em /uploads (dev). Em produção só com volume persistente
#   montado em UPLOADS_DIR + UPLOADS_PERSISTENTE=true — disco de container some a cada deploy.
# - "s3": bucket S3-compatível (Cloudflare R2, AWS S3, MinIO); a foto é lida pela URL pública do bucket.
STORAGE_DRIVER="local"
UPLOADS_DIR="./uploads"
# UPLOADS_PERSISTENTE="true"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"   # vazio = AWS S3; SEM o /<bucket> que o painel do R2 mostra no fim
# S3_REGION="auto"                                              # R2: auto; AWS: a região do bucket
# S3_BUCKET="vetor-midia"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL="https://pub-xxxx.r2.dev"                        # URL pública do bucket (sem / no fim)
# S3_FORCE_PATH_STYLE="false"                                    # true pra MinIO
